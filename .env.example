# Runtime secrets. Do not commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# MCP server (POST /api/mcp). Leave empty to disable. Must be at least 32 random
# characters, e.g. `openssl rand -hex 32`.
MCP_AUTH_TOKEN=
# Image generation is lazy and cached per meal suggestion.

# Runtime behavior.
PUBLIC_BASE_URL=https://meals.example.com
APP_TIMEZONE=Europe/Amsterdam
TELEGRAM_DAILY_CRON=30 18 * * *

