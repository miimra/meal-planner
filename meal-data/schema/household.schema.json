{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meal.number34.nl/schema/household.schema.json",
  "title": "Meal planner household",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "members", "preferences"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/member" }
    },
    "preferences": { "$ref": "#/$defs/preferences" }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "active"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spicy", "salt", "sugar"],
      "properties": {
        "spicy": { "type": "boolean" },
        "salt": { "type": "string", "minLength": 1 },
        "sugar": { "type": "string", "minLength": 1 }
      }
    }
  }
}
