{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meal.number34.nl/schema/day.schema.json",
  "title": "Meal planner day",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "date", "meals"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "date": { "type": "string", "format": "date" },
    "meals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["breakfast", "lunch", "dinner"],
      "properties": {
        "breakfast": { "$ref": "#/$defs/meal" },
        "lunch": { "$ref": "#/$defs/meal" },
        "dinner": { "$ref": "#/$defs/meal" }
      }
    }
  },
  "$defs": {
    "recipeId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "memberId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "takenBy", "createdAt"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "takenBy": {
          "oneOf": [
            { "$ref": "#/$defs/memberId" },
            { "type": "null" }
          ]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "cooked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipeId", "cookedAt", "changes", "photos"],
      "properties": {
        "recipeId": {
          "oneOf": [
            { "$ref": "#/$defs/recipeId" },
            { "type": "null" }
          ]
        },
        "cookedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "changes": { "type": ["string", "null"] },
        "photos": {
          "type": "array",
          "items": { "$ref": "#/$defs/photo" }
        }
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recipeId",
        "suggestedAt",
        "status",
        "decidedBy",
        "decidedAt",
        "rejectionReason"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "recipeId": { "$ref": "#/$defs/recipeId" },
        "suggestedAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["pending", "accepted", "rejected"] },
        "decidedBy": {
          "oneOf": [
            { "$ref": "#/$defs/memberId" },
            { "type": "null" }
          ]
        },
        "decidedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "rejectionReason": { "type": ["string", "null"] }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "memberId", "rating", "makeAgain", "notes", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "memberId": { "$ref": "#/$defs/memberId" },
        "rating": { "enum": ["liked", "okay", "disliked"] },
        "makeAgain": { "enum": ["yes", "maybe", "no"] },
        "notes": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "meal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "status",
        "plannedRecipeId",
        "suggestions",
        "cooked",
        "feedback"
      ],
      "properties": {
        "category": { "type": ["string", "null"] },
        "status": {
          "enum": ["unplanned", "planned", "cooked", "skipped", "eating_out"]
        },
        "plannedRecipeId": {
          "oneOf": [
            { "$ref": "#/$defs/recipeId" },
            { "type": "null" }
          ]
        },
        "suggestions": {
          "type": "array",
          "items": { "$ref": "#/$defs/suggestion" }
        },
        "cooked": {
          "oneOf": [
            { "$ref": "#/$defs/cooked" },
            { "type": "null" }
          ]
        },
        "feedback": {
          "type": "array",
          "items": { "$ref": "#/$defs/feedback" }
        }
      }
    }
  }
}
