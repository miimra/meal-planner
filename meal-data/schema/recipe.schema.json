{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meal.number34.nl/schema/recipe.schema.json",
  "title": "Meal planner recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "categories",
    "cuisine",
    "servings",
    "prepMinutes",
    "cookMinutes",
    "ingredients",
    "steps",
    "referencePhoto",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cuisine": { "type": ["string", "null"] },
    "servings": { "type": "number", "exclusiveMinimum": 0 },
    "prepMinutes": { "type": ["integer", "null"], "minimum": 0 },
    "cookMinutes": { "type": ["integer", "null"], "minimum": 0 },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ingredient" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "referencePhoto": {
      "oneOf": [
        { "$ref": "#/$defs/referencePhoto" },
        { "type": "null" }
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "quantity", "unit", "notes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "quantity": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "instruction"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "instruction": { "type": "string", "minLength": 1 }
      }
    },
    "referencePhoto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "source"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "source": { "enum": ["generated", "external", "household"] }
      }
    }
  }
}
